# @name healthy
GET {{host}}/health
Accept: application/json

> {%
client.test("is healthy", function () {
	client.assert(response.status >= 200 && response.status < 400);

	if (typeof response.body == 'object' && 'health' in response.body)
		client.assert(response.body.healthy == true);
});
%}

###
# @name Search for known usernames
QUERY {{host}}/
Accept: application/json
Content-Type: application/json

"jcake"
